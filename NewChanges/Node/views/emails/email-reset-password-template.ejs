<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="ar" dir="rtl"
    style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;">

<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>
        <%= title %>
    </title>
</head>

<body itemscope itemtype="http://schema.org/EmailMessage" dir="rtl"
    style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; font-size: 14px; line-height: 1.6em; background-color: #f6f6f6; margin: 0; direction: rtl; text-align: right;"
    bgcolor="#f6f6f6">

    <table class="body-wrap" dir="rtl" width="100%" bgcolor="#f6f6f6" style="direction: rtl;">
        <tr>
            <td></td>
            <td class="container" width="600" align="center" style="margin: 0 auto;">
                <div class="content" style="max-width: 600px; margin: 0 auto; padding: 20px;">
                    <table class="main" dir="rtl" width="100%" cellpadding="0" cellspacing="0" bgcolor="#fff"
                        style="direction: rtl; border-radius: 3px; background-color: #E7D2D2; border: 1px solid #E7D2D2;">
                        <tr>
                            <td align="center" bgcolor="#38414a" style="color: #E7D2D2;background-color: #7A2530; font-weight: 500; padding: 20px;">
                                <a href="#">
                                    <img src="<%= logoUrl %>" height="20" alt="logo" />
                                </a>
                                <br />
                                <span style="margin-top: 10px; display: block;">
                                    <%= title %>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="content-wrap" dir="rtl" align="right" style="padding: 20px; direction: rtl; text-align: right;">
                                <table width="100%" cellpadding="0" cellspacing="0" dir="rtl">
                                    <tr>
                                        <td class="content-block" style="padding: 0 0 20px;">
                                            <%= tr('C6-1', 'ar', { username }) %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="content-block" style="padding: 0 0 20px;">
                                            <%= tr('C6-2') %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="content-block" style="padding: 0 0 20px;">
                                            <a href="<%= resetLink %>" class="btn-primary"
                                                style="color: #FFF; text-decoration: none; font-weight: bold; text-align: center; display: inline-block; border-radius: 5px; background-color: #7A2530; border: 8px 16px solid #7A2530;padding: 11px;" >
                                                <%= buttonText %>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="content-block" style="padding: 0 0 20px;">
                                            <%= tr('C6-3') %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="content-block" style="padding: 0 0 20px;">
                                            <%= tr('C6-4') %>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <div class="footer" style="width: 100%; clear: both; color: #999;">
                        <table width="100%">
                            <tr>
                                <td class="aligncenter content-block" align="center"
                                    style="color: #E7D2D2; font-size: 12px;background-color: #7A2530;padding: 16px;">
                                    <a href="#" style="color: #999; text-decoration: underline;"><%= tr('C6-5') %></a> <%= tr('C6-6') %>.
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </td>
            <td></td>
        </tr>
    </table>

</body>

</html>