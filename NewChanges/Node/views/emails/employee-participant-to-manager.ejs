<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="ar" dir="rtl"
    style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;">

<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title><%= title %></title>
</head>

<body dir="rtl" style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; font-size: 14px; line-height: 1.6em; background-color: #f6f6f6; margin: 0; direction: rtl; text-align: right;">
    <table class="body-wrap" dir="rtl" width="100%" bgcolor="#f6f6f6" style="direction: rtl;">
        <tr>
            <td></td>
            <td class="container" width="600" align="center" style="margin: 0 auto;">
                <div class="content" style="max-width: 600px; margin: 0 auto; padding: 20px;">
                    <table class="main" dir="rtl" width="100%" cellpadding="0" cellspacing="0" bgcolor="#fff"
                        style="direction: rtl; border-radius: 5px; background-color: #ffffff; border: 1px solid #ddd;">
                        <tr>
                            <td align="center" bgcolor="#7A2530"
                                style="color: #fff; font-weight: 500; padding: 20px;">
                                <img src="<%= logoUrl %>" height="80" alt="logo" style="width: 80px; height: 80px;" />
                                <br />
                                <span style="margin-top: 10px; display: block; font-size: 18px;">
                                    <%= title %>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="content-wrap" dir="rtl" align="right" style="padding: 20px; font-size: 16px; color: #333; direction: rtl; text-align: right;">
                                <p><%= tr('C4-1', 'ar', { Manager: managerData?.name || managerData?.nameEn || '' }) %></p>

                                <p>
                                    <%= tr('C4-2', 'ar', { Member: userData?.name || userData?.nameEn || '' }) %>
                                </p>

                                <!-- User Details -->
                                <h3 style="margin-top:20px; color:#7A2530;"><%= tr('C4-3') %></h3>
                                <table style="width: 100%; margin: 10px 0; border-collapse: collapse;" dir="rtl">
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C4-4') %>:</strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= userData?.name %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C4-5') %>:</strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= userData?.email %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C4-6') %>:</strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= userData?.phone %></td>
                                    </tr>
                                    <% if (typeof userDetailsUrl !== 'undefined' && userDetailsUrl) { %>
                                     <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C4-7') %>:</strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;">
                                            <a href="<%= userDetailsUrl %>" target="_blank" style="color:#7A2530; font-weight:bold;"><%= tr('C4-8') %></a>
                                        </td>
                                    </tr>
                                    <% } %>
                                </table>

                                <!-- Event Details -->
                                <h3 style="margin-top:20px; color:#7A2530;"><%= tr('C2-1') %></h3>
                                <table style="width: 100%; margin: 10px 0; border-collapse: collapse;" dir="rtl">
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C2-2') %></strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= eventData?.name %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C2-3') %></strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= eventData?.location %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C2-4') %></strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= eventData?.startDate %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C2-5') %></strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= eventData?.endDate %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C2-6') %></strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= eventData?.startTime %></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong><%= tr('C2-7') %></strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><%= eventData?.endTime %></td>
                                    </tr>
                                </table>

                                <p>
                                    <%= tr('C4-9') %>
                                </p>

                                <p>
                                    <%= tr('C3-1') %>,<br>
                                    <strong><%= tr('C3-3') %></strong><br>
                                    <%= tr('C3-5') %>
                                </p>
                            </td>
                        </tr>
                    </table>
                    <div class="footer" style="width: 100%; clear: both; color: #999; text-align: center; font-size: 12px; margin-top: 20px;">
                        <p style="color: #999;"><%= tr('C3-8') %></p>
                    </div>
                </div>
            </td>
            <td></td>
        </tr>
    </table>
</body>

</html>